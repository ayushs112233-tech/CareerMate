# ==========================================
# CareerMate AI — Environment Configuration Example
# Copy this file to .env and adjust if necessary
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-careermate-dev-secret-key-replace-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Settings (Used by Django to connect)
DB_NAME=careermate_db
DB_USER=careermate_user
DB_PASSWORD=careermate_password
DB_HOST=localhost
DB_PORT=5432

# Docker Compose PostgreSQL Settings (Used by docker-compose.yml)
POSTGRES_DB=careermate_db
POSTGRES_USER=careermate_user
POSTGRES_PASSWORD=careermate_password
POSTGRES_PORT=5432
